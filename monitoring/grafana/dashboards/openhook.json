{
  "uid": "openhook-operations",
  "title": "Openhook \u2014 Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "openhook"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Service available",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"openhook\"}",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Active infrastructure alerts",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"} or vector(0)",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP requests / second by route",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(openhook_http_requests_total[5m]))",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP 5xx / second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(openhook_http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Rate/capacity rejections in five minutes",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(openhook_http_requests_total{status=\"429\"}[5m])) or vector(0)",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "p95 HTTP latency, excluding channel long polls",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(openhook_http_request_duration_seconds_bucket{route!~\"/mcp|/api/v1/channels|/api/v1/sessions\"}[5m])))",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "MCP tool calls / second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (rate(openhook_mcp_tool_calls_total[5m]))",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Retained channels (includes tests)",
      "type": "stat",
      "description": "Anonymous retained channels, not distinct people or confirmed adoption.",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "openhook_channels",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "Database capacity used",
      "type": "gauge",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "openhook_storage_used_bytes / openhook_storage_limit_bytes",
          "legendFormat": "{{route}}{{tool}}{{transport}} {{traffic}}{{outcome}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
