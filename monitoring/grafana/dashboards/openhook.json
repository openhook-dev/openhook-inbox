      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "openhook-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (rate(openhook_mcp_tool_calls_total[5m]))",
